# Proyecto real AlertaEdu (URL y clave publicable; NO permiten abrir PostgreSQL sin contraseña)
SUPABASE_URL=https://lwjnmebmotcnkjrhhbyl.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_uQVI9Ls7I2_Lod07SHYqZA_IQejwQM7
# AÑADE AQUÍ tu clave de PostgreSQL solo en tu PC, preferiblemente con CONFIGURAR_WINDOWS.bat
# Este es el endpoint directo (IPv6); en redes IPv4 usa Connect > Session pooler.
DATABASE_URL=
# URL del servidor AlertaEdu para enlaces de correo (si se deja vacía, Render usa RENDER_EXTERNAL_URL)
ALERTAEDU_BASE_URL=
# Para Render configura estos valores en Environment, NO en .env del repositorio
ALERTAEDU_ENV=development
ALERTAEDU_AUTH_PROVIDER=supabase
ALERTAEDU_BOOTSTRAP_TOKEN=
# El remitente Gmail necesita contraseña de APLICACIÓN (Google > Seguridad)
ALERTAEDU_SMTP_USER=
ALERTAEDU_SMTP_APP_PASSWORD=
# Sin estudiantes falsos por defecto
ALERTAEDU_SEED_DEMO=0

# Proveedores directos para la recuperación de cuentas locales antiguas.
# La recuperación activa con Supabase Auth usa el SMTP configurado en el dashboard Supabase.
ALERTAEDU_EMAIL_PROVIDER=gmail
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=AlertaEdu
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Google Apps Script: valores PRIVADOS solo en Render Environment (NO GitHub)
# La URL debe terminar en /exec. El secreto debe coincidir con Script Properties.
ALERTAEDU_APPS_SCRIPT_URL=
ALERTAEDU_APPS_SCRIPT_SECRET=
